{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "regions": ["cdg1"],
  "github": {
    "silent": false
  },
  "crons": [
    {
      "path": "/api/cron/daily-reminder",
      "schedule": "0 8 * * *"
    }
  ]
}

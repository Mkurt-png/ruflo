{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "regions": ["yul1"],
  "github": {
    "silent": false
  },
  "crons": [
    {
      "path": "/api/cron/daily-reminder",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/notifications",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 18 * * 0"
    }
  ]
}

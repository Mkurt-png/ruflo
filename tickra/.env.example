# ─────────────────────────────────────────────────────────────────
# Tickra · environment variables
# Copy this file to `.env.local` and fill values for the keys you need.
# Keys are grouped by concern. Anything blank below is required for the
# corresponding feature to actually work in production; the app boots
# fine without them but related routes will fall back to stubs / errors.
# ─────────────────────────────────────────────────────────────────

# ─── 1. Core ──────────────────────────────────────────────────────
# Canonical site URL — used by SEO (sitemap, OG, Schema.org Organization)
# and by anything that needs to build absolute links (Stripe success_url,
# email magic-link callbacks, etc.). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://tickra.com

# Node env — leave as-is in code-style envs; Vercel sets it automatically.
NODE_ENV=development


# ─── 2. Database & Auth (Supabase) ────────────────────────────────
# Required for user accounts, journal entries, progress, achievements,
# saved bookmarks. The signin/onboarding flows fall through to a
# placeholder if these are missing.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: sign tokens for magic-link auth (use any strong secret).
AUTH_SECRET=


# ─── 3. OAuth Google ──────────────────────────────────────────────
# Required to enable the "Continue with Google" button.
# Create the OAuth client in https://console.cloud.google.com → APIs → Credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Authorised redirect must match: ${NEXT_PUBLIC_SITE_URL}/api/auth/google/callback


# ─── 4. Stripe (payments) ─────────────────────────────────────────
# Required to actually take payments. Without these, /api/checkout
# returns an error and the pricing buttons surface "Paiement indisponible".
STRIPE_SECRET_KEY=                  # sk_live_... or sk_test_...
STRIPE_WEBHOOK_SECRET=              # whsec_... (from `stripe listen` or dashboard)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY= # pk_live_... or pk_test_...

# Price IDs from Stripe dashboard (Products → Prices).
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_LIFETIME=


# ─── 5. Email (Resend) ────────────────────────────────────────────
# Required for transactional mail: magic-link, welcome, password-reset,
# digest, newsletter. The /api/newsletter route accepts subscriptions
# even when this is empty, but no email actually goes out.
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@tickra.com   # must be on a verified domain


# ─── 6. AI (Ask Tickra assistant) ─────────────────────────────────
# Required for the floating /ai/chat assistant. Without it the bubble is
# hidden by feature flag.
ANTHROPIC_API_KEY=
# OR fall back to OpenAI if you prefer:
OPENAI_API_KEY=


# ─── 7. Analytics (Plausible · self-hosted or cloud) ──────────────
# Privacy-first analytics. Optional but recommended.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=tickra.com
NEXT_PUBLIC_PLAUSIBLE_SCRIPT=https://plausible.io/js/script.js


# ─── 8. Error monitoring (Sentry) ─────────────────────────────────
# Optional. The error.tsx and route handlers include a hook ready to
# forward errors when the DSN is set.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=


# ─── 9. Feature flags ─────────────────────────────────────────────
# Disable expensive surfaces while waiting for content / data.
NEXT_PUBLIC_ENABLE_BATTLE=true
NEXT_PUBLIC_ENABLE_SIMULATOR=true
NEXT_PUBLIC_ENABLE_AI_ASSISTANT=false
NEXT_PUBLIC_ENABLE_NEW_LANDING=true   # the editorial 7-room landing


# ─── 10. CRON secrets ────────────────────────────────────────────
# Vercel cron jobs hit /api/cron/* — protect with a shared secret
# checked at the route boundary.
CRON_SECRET=

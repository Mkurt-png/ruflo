# ==========================================
# BOT DE TRADING FOREX - Configuration
# ==========================================
# Copier vers .env et remplir les valeurs

# ---- OANDA API ----
OANDA_API_KEY=your_oanda_api_key_here
OANDA_ACCOUNT_ID=your_account_id_here
OANDA_ENVIRONMENT=practice  # practice ou live

# ---- SÉCURITÉ ----
SECRET_KEY=your_super_secret_key_change_this_in_production_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_secure_password

# ---- BASE DE DONNÉES ----
DATABASE_URL=sqlite+aiosqlite:///./data/forex_bot.db
# Pour PostgreSQL en production:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/forex_bot

# ---- REDIS ----
REDIS_URL=redis://localhost:6379/0

# ---- TELEGRAM ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- EMAIL ----
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=alert_email@gmail.com
EMAIL_USE_TLS=true

# ---- STRATÉGIE DE TRADING ----
RISK_PER_TRADE=0.015        # 1.5% du capital par trade
MAX_OPEN_TRADES=4            # Maximum de trades simultanés
MAX_DAILY_DRAWDOWN=0.05     # 5% de drawdown max par jour
MIN_RISK_REWARD=2.5          # R:R minimum
MIN_CONFLUENCE_SCORE=70      # Score minimum pour trader

# ---- PAIRES ACTIVES ----
TRADING_PAIRS=EUR_USD,GBP_USD,USD_JPY,AUD_USD,USD_CAD,EUR_GBP,GBP_JPY

# ---- BOT ----
AUTO_START=false             # Démarrage automatique du bot
CHECK_INTERVAL_SECONDS=30   # Intervalle de vérification des positions

# ---- API ----
CORS_ORIGINS=http://localhost:3000,http://localhost:80
